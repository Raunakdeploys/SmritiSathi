# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API Key for Satellite & Street View cartography.
VITE_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# TWILIO / WHATSAPP & OUTBOUND VOICE EMERGENCY SOS INTEGRATION
# ==============================================================================
# 1. Twilio Account SID & Auth Token (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# 2. Twilio WhatsApp Sender Number (e.g. whatsapp:+14155238886 for Twilio sandbox or your registered WhatsApp sender)
TWILIO_WHATSAPP_FROM=

# 3. Twilio Outbound Voice Number (e.g. +12055550199 or your verified Twilio caller ID)
TWILIO_VOICE_FROM=

# 4. (Optional) Meta WhatsApp Cloud API (Alternative provider for WhatsApp messages)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# 5. (Optional) Designated Caregiver Emergency Phone Override (E.164 international format e.g. +919073719787)
CAREGIVER_EMERGENCY_PHONE=

