# ==============================================================================
# SMRITISATHI ENVIRONMENT CONFIGURATION
# NOTE: NO VITE_* variables are required! The application runs completely
# out-of-the-box with pre-bundled Firebase & cloud configs.
# ==============================================================================

# Server-side Gemini AI features (Server runtime only)
GEMINI_API_KEY=

# ==============================================================================
# OPTIONAL BACKEND OVERRIDES (Defaults already bundled in firebase-applet-config.json)
# ==============================================================================
# None of these are required for standard deployment.
# VITE_FIREBASE_API_KEY=
# VITE_GOOGLE_CLIENT_ID=
# VITE_API_URL=
# VITE_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# FIREBASE ADMIN SDK (Backend Server - Render / Express)
# ==============================================================================
# Option A: Full service account JSON string from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT=

# Option B: Discrete credentials (alternative to FIREBASE_SERVICE_ACCOUNT)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Allowed frontend origin(s) for CORS on Render backend (e.g. https://smritisathi.vercel.app)
FRONTEND_URL=
ALLOWED_ORIGINS=

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API Key for Satellite & Street View cartography.
VITE_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# TWILIO / WHATSAPP & OUTBOUND VOICE EMERGENCY SOS INTEGRATION
# ==============================================================================
# 1. Twilio Account SID & Auth Token (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# 2. Twilio WhatsApp Sender Number (e.g. whatsapp:+14155238886 for Twilio sandbox or your registered WhatsApp sender)
TWILIO_WHATSAPP_FROM=

# 3. Twilio Outbound Voice Number (e.g. +12055550199 or your verified Twilio caller ID)
TWILIO_VOICE_FROM=

# 4. (Optional) Meta WhatsApp Cloud API (Alternative provider for WhatsApp messages)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# 5. (Optional) Designated Caregiver Emergency Phone Override (E.164 international format e.g. +919073719787)
CAREGIVER_EMERGENCY_PHONE=

